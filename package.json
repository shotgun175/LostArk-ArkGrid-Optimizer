{
  "name": "lostark-arkgrid-optimizer",
  "private": true,
  "version": "0.3.18",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-tesseract.cjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-tesseract.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "test": "vitest run && tsx scripts/cv-tests.mts",
    "test:unit": "vitest run",
    "test:cv": "tsx scripts/cv-tests.mts",
    "test:cv-accuracy": "tsx scripts/cv-accuracy.mts",
    "test:cv-ocr": "tsx scripts/cv-ocr-accuracy.mts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "knip": "knip",
    "format": "prettier --write .",
    "generate:sprite": "node scripts/generate-sprite.cjs",
    "generate:pipeline": "node scripts/extract-pipeline.cjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/dom-mediacapture-transform": "^0.1.12",
    "@types/node": "^24.6.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.39.4",
    "jpeg-js": "^0.4.4",
    "knip": "^6.39.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.39.6",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@zerodevx/svelte-toast": "^0.9.6",
    "svelte-persisted-state": "^1.4.1",
    "tesseract.js": "^5.1.1"
  }
}
