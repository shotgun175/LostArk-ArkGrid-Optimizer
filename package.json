{
  "name": "lostark-arkgrid-optimizer",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run && tsx scripts/cv-tests.mts",
    "test:unit": "vitest run",
    "test:cv": "tsx scripts/cv-tests.mts",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "generate:sprite": "node scripts/generate-sprite.cjs",
    "generate:pipeline": "node scripts/extract-pipeline-table.cjs",
    "generate:support-cutquality": "node scripts/generate-support-cutquality.cjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^24.6.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "spritesmith": "^3.5.1",
    "svelte": "^5.39.6",
    "svelte-check": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@techstark/opencv-js": "^4.12.0-release.1",
    "@types/dom-mediacapture-transform": "^0.1.11",
    "@zerodevx/svelte-toast": "^0.9.6",
    "svelte-persisted-state": "^1.2.0"
  }
}
